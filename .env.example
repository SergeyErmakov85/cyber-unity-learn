# Supabase — задайте значения в Codex Cloud; для сайта используйте настройки проекта Lovable.
# VITE_* доступны браузеру: здесь допустим только publishable/anon key.
# Серверные service_role / secret keys остаются в Supabase Edge Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
